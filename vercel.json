{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "server.js": {
      "includeFiles": "{lib/**,api/**,*.html,*.js,*.json,*.png,*.svg,*.webmanifest}"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/session", "destination": "/api/session" },
    { "source": "/api/push/subscribe", "destination": "/api/push/subscribe" },
    { "source": "/api/notifications/stream", "destination": "/api/notifications" },
    { "source": "/api/notify", "destination": "/api/notify" },
    { "source": "/api/notifications", "destination": "/api/notifications" },
    { "source": "/api/data", "destination": "/api/data" },
    { "source": "/", "destination": "/Dps.html" }
  ]
}

